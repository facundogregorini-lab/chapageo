# ---------------------------------------------------------------------------
# Base de datos (compartida por la web y el worker). libSQL / Turso.
# Sin esto usa ./data/chapageo.db en local. En Vercel sin base usa /tmp (efímero, solo demo).
# También se aceptan TURSO_DATABASE_URL y TURSO_AUTH_TOKEN (integración de Vercel Storage).
# ---------------------------------------------------------------------------
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Firma de sesiones de la web. Generá uno con: openssl rand -base64 32
AUTH_SECRET=

# Ingreso con Google (opcional). Sin las dos variables, el botón no aparece.
# Cliente OAuth "Aplicación web" en Google Cloud; URI de redirección: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL pública de la web (ej: https://chapageo.vercel.app). Si queda vacía se usa el origen del request.
APP_URL=

# Cargar la demo (clientes ficticios, datos simulados) al iniciar una base vacía (1 = sí)
DEMO_SEED=1

# ---------------------------------------------------------------------------
# Límites de uso (valores por defecto conservadores)
# ---------------------------------------------------------------------------
MAX_EXECUTIONS_PER_ANALYSIS=120
MAX_DAILY_EXECUTIONS_PER_AGENCY=300
MAX_ACTIVE_ANALYSES_PER_AGENCY=2
MAX_CLIENTS_PER_AGENCY=15
JOB_MAX_ATTEMPTS=3
STALE_JOB_SECONDS=120
WORKER_OFFLINE_SECONDS=90
CHECKER_DAILY_LIMIT=
# Chequeos gratis por día (en total) que usan Bright Data; cada uno son 5 registros. Después, API oficial o solo auditoría.
CHECKER_BRIGHTDATA_MAX_PER_DAY=40
# 1 = mostrar los motores que corren en un worker propio (captura con navegador y APIs oficiales).
# Vacío = solo Bright Data, sin opciones ni avisos del worker.
WORKER_ENABLED=

# ---------------------------------------------------------------------------
# Worker (solo en la máquina/contenedor del worker; nunca en el frontend)
# ---------------------------------------------------------------------------
WORKER_ID=
# Conectores de captura web a habilitar en este worker (separados por coma). Vacío = ninguno.
WORKER_WEB_COLLECTORS=chatgpt_web
WORKER_CONCURRENCY=1
WORKER_POLL_MS=3000
WORKER_HEARTBEAT_MS=15000
# Pausa entre consultas al mismo asistente web (ms)
WORKER_WEB_DELAY_MS=8000
JOB_TIMEOUT_MS=240000
# Navegador
WORKER_SESSION_DIR=.worker-sessions
WORKER_HEADLESS=1
WORKER_CHROMIUM_PATH=
WORKER_BROWSER_LOCALE=es-AR
WORKER_BROWSER_TIMEZONE=America/Argentina/Buenos_Aires
WORKER_NAV_TIMEOUT_MS=45000
WORKER_RESPONSE_TIMEOUT_MS=150000
WORKER_STABLE_MS=3000
# País de salida que el OPERADOR declara para la IP del worker (ej: AR). No se verifica solo:
# queda registrado como "declarada por el operador".
WORKER_EGRESS_COUNTRY=
CHATGPT_URL=https://chatgpt.com/
GEMINI_URL=https://gemini.google.com/app
# 1 = no habilitar conectores de API oficial aunque haya claves
WORKER_DISABLE_API=

# ---------------------------------------------------------------------------
# Bright Data (captura de ChatGPT / Gemini / Perplexity sin worker). Va en Vercel.
# API key: panel de Bright Data → Account settings → API key. Nunca en el frontend ni en Git.
# (También se acepta BRIGHTDATA_API_TOKEN, el nombre anterior.)
# ---------------------------------------------------------------------------
BRIGHTDATA_API_KEY=
# Ids de los scrapers («… search by prompt»). Vacío = el id del panel que ya viene en el código:
# ChatGPT gd_m7aof0k82r803d5bjm, Gemini gd_mbz66arm2mf9cu856y, Perplexity gd_m7dhdot1vw9a7gc1n.
BRIGHTDATA_DATASET_CHATGPT=
BRIGHTDATA_DATASET_GEMINI=
BRIGHTDATA_DATASET_PERPLEXITY=
# Solo ChatGPT: 1 = pedir que fuerce la búsqueda web. Vacío = ChatGPT decide, como con cualquier usuario.
BRIGHTDATA_CHATGPT_WEB_SEARCH=
# Tope global de consultas por día (protege el presupuesto) y costo estimado por registro.
BRIGHTDATA_MAX_RECORDS_PER_DAY=300
BRIGHTDATA_COST_PER_RECORD=0.0015
# Minutos máximos de espera de un lote antes de reintentar.
BRIGHTDATA_MAX_WAIT_MIN=30

# ---------------------------------------------------------------------------
# API oficial (opcional, claves del OPERADOR de ChapaGEO, nunca de las agencias).
# Se muestra como método "API oficial", distinto de la captura web. Sin clave, el motor no aparece.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---------------------------------------------------------------------------
# Comercial (opcional)
# ---------------------------------------------------------------------------
ADMIN_EMAILS=
PAY_LINK_DIAGNOSTICO=
PAY_LINK_MARCA=
PAY_LINK_AGENCIA=
SALES_WHATSAPP=
