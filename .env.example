# Base de datos (libSQL / Turso). Sin esto usa ./data/chapageo.db en local
# y /tmp en Vercel (efímero: solo para demo).
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Firma de sesiones. Generá uno con: openssl rand -base64 32
AUTH_SECRET=

# Motores de IA. Cada motor sin clave corre en modo SIMULADO (marcado en toda la UI).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Cron semanal (Vercel Cron manda Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Emails con acceso al panel de métricas PMF (separados por coma). Vacío = todos.
ADMIN_EMAILS=

# Links de pago de Mercado Pago (o el que uses) para cada oferta
PAY_LINK_DIAGNOSTICO=
PAY_LINK_MARCA=
PAY_LINK_AGENCIA=

# WhatsApp de ventas, formato internacional sin + (ej: 5491112345678)
SALES_WHATSAPP=

# Cargar datos de demostración al iniciar una base vacía (1 = sí)
DEMO_SEED=1
